<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="add_benefits_employee" model="ir.ui.view">
        <field name="name">add.benefits.employee.list</field>
        <field name="model">benefits.dashboard</field>
        <field name="arch" type="xml">
            <list edit="True" editable="bottom">
                <field name="employee_id"/>
                <field name="add_benefits"/>
            </list>
        </field>
    </record>

    <record id="action_add_benefits_employee" model="ir.actions.act_window">
        <field name="name">Add monthly additions</field>
        <field name="res_model">benefits.dashboard</field>
        <field name="view_mode">list</field>
    </record>
</odoo>